//@version=6
indicator("Bias Data Feeder [NQ Bot]", overlay=true, scale=scale.right)

// ==================== INPUTS ====================
string webhookSecret = input.string("mySecretKey123", "Webhook Secret", group="WEBHOOK")
string rthSession = input.session("0930-1600", "RTH Session", group="SESSION")
string ethSession = input.session("1800-0930", "ETH/Overnight Session", group="SESSION")
string tz = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "UTC"], group="SESSION")
int openDriveMinutes = input.int(15, "Opening drive minutes", minval=5, maxval=30, group="SESSION")

// ==================== SESSION DETECTION ====================
bool inRTH = not na(time(timeframe.period, rthSession, tz))
bool inETH = not na(time(timeframe.period, ethSession, tz))
bool rthJustOpened = inRTH and not inRTH[1]
bool rthJustClosed = not inRTH and inRTH[1]

// ==================== OVERNIGHT RANGE ====================
var float overnightHigh = na
var float overnightLow = na
var bool overnightSent = false

// Track overnight high/low during ETH
if inETH and not inRTH
    if na(overnightHigh) or high > overnightHigh
        overnightHigh := high
    if na(overnightLow) or low < overnightLow
        overnightLow := low
    overnightSent := false

// Send overnight range at RTH open
if rthJustOpened and not overnightSent and not na(overnightHigh) and not na(overnightLow)
    alert(str.format('{"action":"bias","overnightHigh":{0},"overnightLow":{1},"rthOpen":{2},"secret":"{3}"}', str.tostring(overnightHigh), str.tostring(overnightLow), str.tostring(open), webhookSecret), alert.freq_once_per_bar)
    overnightSent := true

// Reset overnight at ETH start (after RTH close)
if rthJustClosed
    overnightHigh := na
    overnightLow := na

// ==================== PRIOR DAY LEVELS ====================
// Get prior day POC, VAH, VAL from daily data
var float priorPOC = na
var float priorVAH = na
var float priorVAL = na
var float priorClose = na
var bool priorSent = false

// Simple approach: use prior day high/low/close as proxy for VA
// For real VA you'd use your TPO indicator data
float dailyHigh = request.security(syminfo.tickerid, "1D", high[1])
float dailyLow = request.security(syminfo.tickerid, "1D", low[1])
float dailyClose = request.security(syminfo.tickerid, "1D", close[1])

// Estimate VA from prior day (70% range centered on close)
float dailyRange = dailyHigh - dailyLow
float estVAH = dailyClose + dailyRange * 0.35
float estVAL = dailyClose - dailyRange * 0.35
float estPOC = dailyClose  // Close as POC proxy

// Send prior day levels at RTH open
if rthJustOpened and not priorSent
    priorPOC := estPOC
    priorVAH := estVAH
    priorVAL := estVAL
    priorClose := dailyClose
    alert(str.format('{"action":"bias","poc":{0},"vah":{1},"val":{2},"close":{3},"secret":"{4}"}', str.tostring(priorPOC), str.tostring(priorVAH), str.tostring(priorVAL), str.tostring(priorClose), webhookSecret), alert.freq_once_per_bar)
    priorSent := true

if rthJustClosed
    priorSent := false

// ==================== OPENING DRIVE ====================
var float openDriveHigh = na
var float openDriveLow = na
var int rthOpenBar = na
var bool openDriveSent = false

if rthJustOpened
    openDriveHigh := high
    openDriveLow := low
    rthOpenBar := bar_index
    openDriveSent := false

// Track first N minutes
int barsInDrive = openDriveMinutes  // 1 bar = 1 min on 1-min chart
if inRTH and not na(rthOpenBar) and bar_index <= rthOpenBar + barsInDrive
    if high > openDriveHigh
        openDriveHigh := high
    if low < openDriveLow
        openDriveLow := low

// Send opening drive result after N minutes
if inRTH and not na(rthOpenBar) and bar_index == rthOpenBar + barsInDrive and not openDriveSent
    alert(str.format('{"action":"bias","openDriveHigh":{0},"openDriveLow":{1},"openDriveClose":{2},"secret":"{3}"}', str.tostring(openDriveHigh), str.tostring(openDriveLow), str.tostring(close), webhookSecret), alert.freq_once_per_bar)
    openDriveSent := true

// ==================== VOLUME DELTA ====================
// Send buy/sell volume every 5 minutes during RTH
float barRange = high - low
float buyPct = barRange > 0 ? (close - low) / barRange : 0.5
float buyVol = volume * buyPct
float sellVol = volume * (1.0 - buyPct)

// Accumulate over 5 bars (5 min on 1-min chart)
var float accumBuy = 0.0
var float accumSell = 0.0
var int accumCount = 0

if inRTH
    accumBuy += buyVol
    accumSell += sellVol
    accumCount += 1

    if accumCount >= 5
        alert(str.format('{"action":"bias","buyVol":{0},"sellVol":{1},"price":{2},"secret":"{3}"}', str.tostring(math.round(accumBuy)), str.tostring(math.round(accumSell)), str.tostring(close), webhookSecret), alert.freq_once_per_bar)
        accumBuy := 0.0
        accumSell := 0.0
        accumCount := 0

// Reset at session start
if rthJustOpened
    accumBuy := 0.0
    accumSell := 0.0
    accumCount := 0

// ==================== CONTINUOUS PRICE UPDATE ====================
// Send price every bar so the bot can track mitigation
if inRTH
    alert(str.format('{"action":"price","price":{0},"secret":"{1}"}', str.tostring(close), webhookSecret), alert.freq_once_per_bar)

// ==================== VISUAL ====================
// Show session state on chart
bgcolor(rthJustOpened ? color.new(color.green, 90) : na)
plotshape(rthJustOpened, "RTH Open", shape.diamond, location.abovebar, color.green, size=size.tiny)
