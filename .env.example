# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Channel ID for alerts
CHANNEL_ID=your_channel_id_here

# Symbol
SYMBOL=NQ

# Update embed every N seconds
UPDATE_INTERVAL=30

# Timezone
TIMEZONE=America/New_York

# Webhook port (for TradingView alerts)
WEBHOOK_PORT=3000

# Secret (must match what you put in TradingView alert JSON)
WEBHOOK_SECRET=your_secret_here
